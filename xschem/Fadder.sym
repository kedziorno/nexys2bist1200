v {xschem version=3.4.6RC file_version=1.2}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
T {@symname} -45 -6 0 0 0.3 0.3 {}
T {@name} 135 -52 0 0 0.2 0.2 {}
L 4 -130 -40 130 -40 {}
L 4 -130 40 130 40 {}
L 4 -130 -40 -130 40 {}
L 4 130 -40 130 40 {}
B 5 147.5 -32.5 152.5 -27.5 {name=cmpPwm sig_type=typeIntArray dir=inout dir=inout}
L 7 130 -30 150 -30 {}
T {cmpPwm} 125 -34 0 1 0.2 0.2 {}
B 5 -152.5 -32.5 -147.5 -27.5 {name=sw[c_number_switches-1:0] dir=in vhdl_type=STD_LOGIC dir=in}
L 4 -150 -30 -130 -30 {}
T {sw[c_number_switches-1:0]} -125 -34 0 0 0.2 0.2 {}
B 5 -152.5 -12.5 -147.5 -7.5 {name=ckFade dir=in vhdl_type=STD_LOGIC dir=in}
L 4 -150 -10 -130 -10 {}
T {ckFade} -125 -14 0 0 0.2 0.2 {}
B 5 -152.5 7.5 -147.5 12.5 {name=ck dir=in vhdl_type=STD_LOGIC dir=in}
L 4 -150 10 -130 10 {}
T {ck} -125 6 0 0 0.2 0.2 {}
B 3 -152.5 27.5 -147.5 32.5 {name=c_number_switches generic_type=integer  value="1" generic_type=integer}
L 4 -150 30 -130 30 {}
T {c_number_switches} -125 26 0 0 0.2 0.2 {}
